# Copy to server/.env and fill in. Never commit the real .env file.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ast_education
# Comma-separated list of exact frontend origins allowed to call the API
CLIENT_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 when running directly)
TRUST_PROXY=0
# Enquiries allowed per IP address in a 15-minute window
ENQUIRY_RATE_LIMIT_MAX=5

# Image storage. Development and tests use "local". Production must use "s3".
MEDIA_STORAGE=local
# Local folder for development images. It is never served directly by the web server.
MEDIA_LOCAL_DIR=var/media
# Largest accepted upload in megabytes (1 to 10). Keep in step with the client limit (6 MB).
MEDIA_MAX_UPLOAD_MB=6

# S3-compatible provider (AWS S3, Cloudflare R2, Backblaze B2, MinIO). Required when MEDIA_STORAGE=s3.
S3_BUCKET=
S3_REGION=
# Leave empty for AWS. Set for R2, B2 or MinIO, for example https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "true" for MinIO and some self-hosted providers, "false" otherwise
S3_FORCE_PATH_STYLE=false

{
  "name": "ast-education-server",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/enquiry.test.ts && tsx test/admin.test.ts && tsx test/content.test.ts && tsx test/publication.test.ts && tsx test/media.test.ts && tsx test/widths.test.ts && tsx test/cors.test.ts && tsx test/authz.test.ts && tsx test/flow.test.ts && tsx test/videos.test.ts",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "seed:content": "tsx src/scripts/seedContent.ts",
    "media:cleanup": "tsx src/scripts/cleanupMedia.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "sharp": "^0.34.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true
  }
}
